# Use a dedicated development/demo database. Do not point this at production.
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/accommodation_demo?replicaSet=rs0
SEED_MONGO_URI=mongodb://127.0.0.1:27017/accommodation_demo?replicaSet=rs0
SEED_DATABASE_NAME=accommodation_demo
SEED_DASHBOARD_ENABLED=true
SEED_ENVIRONMENT_LABEL=FYP demonstration
# Replace both values below. Demo password: at least 10 characters, at most 72 UTF-8 bytes.
SEED_DEMO_PASSWORD=replace_with_a_demo_password
# Optional overrides for supervisor demo accounts. Defaults are documented in FAKER_SEEDING.md.
# SEED_OWNER_PASSWORD=choose_a_private_demo_owner_password
# SEED_GUEST_PASSWORD=choose_a_private_demo_guest_password
JWT_SECRET=replace_with_a_local_jwt_secret
SEED_BATCH_SIZE=25
CLIENT_URL=http://localhost:5173
PORT=5000
SENTIMENT_API_URL=http://localhost:8000
